set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mips)

set(MIPS_TOOLCHAIN_BIN_HINTS)

if(DEFINED ENV{MIPS_TOOLCHAIN_BIN} AND NOT "$ENV{MIPS_TOOLCHAIN_BIN}" STREQUAL "")
	list(APPEND MIPS_TOOLCHAIN_BIN_HINTS "$ENV{MIPS_TOOLCHAIN_BIN}")
endif()

if(DEFINED ENV{MIPS_TOOLCHAIN_ROOT} AND NOT "$ENV{MIPS_TOOLCHAIN_ROOT}" STREQUAL "")
	list(APPEND MIPS_TOOLCHAIN_BIN_HINTS "$ENV{MIPS_TOOLCHAIN_ROOT}/bin")
endif()

find_program(MIPS_GCC NAMES mips-linux-gnu-gcc.exe mips-linux-gnu-gcc HINTS ${MIPS_TOOLCHAIN_BIN_HINTS})
find_program(MIPS_GXX NAMES mips-linux-gnu-g++.exe mips-linux-gnu-g++ HINTS ${MIPS_TOOLCHAIN_BIN_HINTS})
find_program(MIPS_AR NAMES mips-linux-gnu-gcc-ar.exe mips-linux-gnu-gcc-ar HINTS ${MIPS_TOOLCHAIN_BIN_HINTS})
find_program(MIPS_RANLIB NAMES mips-linux-gnu-gcc-ranlib.exe mips-linux-gnu-gcc-ranlib HINTS ${MIPS_TOOLCHAIN_BIN_HINTS})
find_program(MIPS_STRIP NAMES mips-linux-gnu-strip.exe mips-linux-gnu-strip HINTS ${MIPS_TOOLCHAIN_BIN_HINTS})

if(NOT MIPS_GCC OR NOT MIPS_GXX)
	message(FATAL_ERROR "MIPS toolchain not found. Set MIPS_TOOLCHAIN_BIN or MIPS_TOOLCHAIN_ROOT, or add the toolchain bin directory to PATH.")
endif()

get_filename_component(MIPS_TOOLCHAIN_BIN_DIR "${MIPS_GCC}" DIRECTORY)
get_filename_component(MIPS_TOOLCHAIN_ROOT "${MIPS_TOOLCHAIN_BIN_DIR}" DIRECTORY)

set(DEFAULT_MIPS_SYSROOT "${MIPS_TOOLCHAIN_ROOT}/mips-linux-gnu/libc")

set(MIPS_SYSROOT "${DEFAULT_MIPS_SYSROOT}" CACHE PATH "MIPS target sysroot")

if(NOT EXISTS "${MIPS_SYSROOT}")
	message(FATAL_ERROR "MIPS sysroot not found: ${MIPS_SYSROOT}")
endif()

set(CMAKE_C_COMPILER "${MIPS_GCC}" CACHE FILEPATH "MIPS C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${MIPS_GXX}" CACHE FILEPATH "MIPS C++ compiler" FORCE)
set(CMAKE_SYSROOT "${MIPS_SYSROOT}" CACHE PATH "MIPS sysroot" FORCE)
set(CMAKE_SYSROOT_COMPILE "${MIPS_SYSROOT}" CACHE PATH "MIPS compile sysroot" FORCE)
set(CMAKE_SYSROOT_LINK "${MIPS_SYSROOT}" CACHE PATH "MIPS link sysroot" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING "Cross-compile try_compile target type" FORCE)

set(CMAKE_FIND_ROOT_PATH
	"${MIPS_SYSROOT}"
	"${MIPS_TOOLCHAIN_ROOT}/mips-linux-gnu"
	CACHE STRING "MIPS find root paths" FORCE
)

set(MIPS_LINKER_FLAGS
	"--sysroot=${MIPS_SYSROOT}"
	"-Wl,-rpath-link,${MIPS_SYSROOT}/lib"
	"-Wl,-rpath-link,${MIPS_SYSROOT}/usr/lib"
	"-Wl,-rpath-link,${MIPS_TOOLCHAIN_ROOT}/mips-linux-gnu/lib"
	"-Wl,-rpath-link,${MIPS_TOOLCHAIN_ROOT}/mips-linux-gnu/lib32"
)
string(JOIN " " MIPS_LINKER_FLAGS_STR ${MIPS_LINKER_FLAGS})
set(CMAKE_EXE_LINKER_FLAGS "${MIPS_LINKER_FLAGS_STR}" CACHE STRING "MIPS executable linker flags" FORCE)
set(CMAKE_SHARED_LINKER_FLAGS "${MIPS_LINKER_FLAGS_STR}" CACHE STRING "MIPS shared linker flags" FORCE)
set(CMAKE_MODULE_LINKER_FLAGS "${MIPS_LINKER_FLAGS_STR}" CACHE STRING "MIPS module linker flags" FORCE)

if(MIPS_AR)
	set(CMAKE_AR "${MIPS_AR}" CACHE FILEPATH "MIPS archiver" FORCE)
	set(CMAKE_C_COMPILER_AR "${MIPS_AR}" CACHE FILEPATH "MIPS C archiver" FORCE)
	set(CMAKE_CXX_COMPILER_AR "${MIPS_AR}" CACHE FILEPATH "MIPS C++ archiver" FORCE)
endif()

if(MIPS_RANLIB)
	set(CMAKE_RANLIB "${MIPS_RANLIB}" CACHE FILEPATH "MIPS ranlib" FORCE)
	set(CMAKE_C_COMPILER_RANLIB "${MIPS_RANLIB}" CACHE FILEPATH "MIPS C ranlib" FORCE)
	set(CMAKE_CXX_COMPILER_RANLIB "${MIPS_RANLIB}" CACHE FILEPATH "MIPS C++ ranlib" FORCE)
endif()

if(MIPS_STRIP)
	set(CMAKE_STRIP "${MIPS_STRIP}" CACHE FILEPATH "MIPS strip" FORCE)
endif()

set(CMAKE_CXX_STANDARD 11)
set(CMAKE_CXX_STANDARD_REQUIRED True)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_CROSS_PLATFORM_NAME ingenic_x2600e_mips)
